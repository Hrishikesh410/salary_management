# ==============================================================================
# Global / Root Environment Configuration Example
# Copy to respective app `.env` files or configure in your deployment environment.
# DO NOT COMMIT REAL SECRETS.
# ==============================================================================

# Backend API Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salary_management?schema=public"

# Frontend Configuration
VITE_API_URL="http://localhost:4000/api"
